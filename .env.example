# DreamStalker Environment Configuration
# Copy this file to .env and fill in your values

# RAGFlow Configuration
RAGFLOW_BASE_URL=http://192.168.0.156:9380
RAGFLOW_API_KEY=your-api-key-here
RAGFLOW_DATASET_ID=your-dataset-id-here

# Audio Configuration (optional, defaults in settings.yaml)
# AUDIO_SAMPLE_RATE=44100
# AUDIO_DEFAULT_DURATION_HOURS=8

# Server Configuration
# SERVER_HOST=127.0.0.1
# SERVER_PORT=8000
